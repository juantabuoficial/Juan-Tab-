rules_version = '2';
// Prototipo para revisión y pruebas: no desplegar automáticamente.
// Modelos existentes: PlanSubvencion, Actuacion, User, ComentarioActuacion,
// RegistroAuditoriaAcceso, NotificacionSistema, CopiaSeguridadPlan.
// Todos los registros nuevos incluyen revisionSync (int), actualizadoPorUid
// (UID inmutable respecto al autor del envío) y actualizadoEnServidor (timestamp).
// directorioPersonal contiene solo identidad profesional, nunca email/teléfono/NIF.
// configuracionesUsuario pertenece exclusivamente al UID de su documento.
service cloud.firestore {
  match /databases/{database}/documents {
    function signed() { return request.auth != null; }
    function profile() { return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data; }
    function active() { return signed() && profile().activo == true && profile().rol in ['administrador','jefe_servicio','tecnico','administrativo','auditor','consulta']; }
    function admin() { return active() && profile().rol == 'administrador'; }
    function manager() { return active() && profile().rol in ['administrador','jefe_servicio']; }
    function editor() { return active() && profile().rol in ['administrador','jefe_servicio','tecnico','administrativo']; }
    function validId(id) { return id is string && id.size()>0 && id.size()<=128 && id.matches('^[a-zA-Z0-9_-]+$'); }
    function text(v,max) { return v is string && v.size()<=max; }
    function optionalText(d,key,max) { return !(key in d) || text(d[key],max); }
    function optionalMoney(d,key) { return !(key in d) || money(d[key]); }
    function list(v,max) { return v is list && v.size()<=max; }
    function money(v) { return v is number && v>=0 && v<=100000000000; }
    function metadata(d,creating) {
      return d.revisionSync is int && d.revisionSync>0 && d.actualizadoPorUid==request.auth.uid && d.actualizadoEnServidor==request.time &&
        (creating ? d.revisionSync==1 : d.revisionSync==resource.data.get('revisionSync',0)+1);
    }
    function sameCreated(d) { return d.fechaCreacion==resource.data.fechaCreacion; }
    function validPlan(d,id) {
      return d.keys().hasOnly(['id','codigo','nombre','descripcion','ejercicio','plazoEjecucionMaximo','plazoJustificacionMaximo','plazoEjecucionAmpliado','plazoJustificacionAmpliado','eellBeneficiarias','actuacionesPrevistas','presupuestoTotal','fechaCreacion','activo','revisionSync','actualizadoPorUid','actualizadoEnServidor']) &&
        d.id==id && validId(id) && text(d.codigo,150) && text(d.nombre,500) && d.nombre.size()>0 && optionalText(d,'descripcion',20000) && d.ejercicio is int && d.ejercicio>=1900 && d.ejercicio<=2200 &&
        money(d.presupuestoTotal) && d.activo is bool && text(d.fechaCreacion,40) && text(d.plazoEjecucionMaximo,40) && text(d.plazoJustificacionMaximo,40) && optionalText(d,'plazoEjecucionAmpliado',40) && optionalText(d,'plazoJustificacionAmpliado',40) &&
        list(d.eellBeneficiarias,500) && list(d.actuacionesPrevistas,1000);
    }
    function validAct(d,id) {
      return d.keys().hasOnly(['id','numero','plan','entidadLocal','nifEntidad','titulo','aplicacionPresupuestaria','faseActual','plazos','importes','documentos','liquidacion','estadoGeneral','tecnicoAsignadoId','tecnicoAsignadoNombre','tecnicoAsignadoCargo','fechaCreacion','fechaModificacion','tecnicosParticipantes','observacionesInternas','revisionSync','actualizadoPorUid','actualizadoEnServidor']) &&
        d.id==id && validId(id) && text(d.numero,150) && text(d.plan,500) && text(d.entidadLocal,500) && text(d.titulo,2000) && d.titulo.size()>0 && optionalText(d,'nifEntidad',30) && optionalText(d,'aplicacionPresupuestaria',150) && optionalText(d,'observacionesInternas',30000) && optionalText(d,'tecnicoAsignadoCargo',300) &&
        text(d.tecnicoAsignadoId,128) && text(d.tecnicoAsignadoNombre,300) && d.plazos is map && d.plazos.keys().hasOnly(['plazoEjecucion','plazoJustificacion','plazoEjecucionAmpliado','plazoJustificacionAmpliado']) && text(d.plazos.plazoEjecucion,40) && text(d.plazos.plazoJustificacion,40) && optionalText(d.plazos,'plazoEjecucionAmpliado',40) && optionalText(d.plazos,'plazoJustificacionAmpliado',40) &&
        d.importes is map && d.importes.keys().hasOnly(['importeActuacion','importeConcesion','importeAdjudicacion','aportacionMunicipal']) && money(d.importes.importeActuacion) && money(d.importes.importeConcesion) && money(d.importes.importeAdjudicacion) && optionalMoney(d.importes,'aportacionMunicipal') &&
        d.liquidacion is map && d.liquidacion.keys().hasOnly(['adjudicacion','justificadoEnPlazo','justificadoEnPlazoConDeficiencias','justificadoFueraDePlazo','justificadoFueraDePlazoConDeficiencias','noJustificado','observacionesLiquidacion']) && money(d.liquidacion.adjudicacion) && money(d.liquidacion.justificadoEnPlazo) && money(d.liquidacion.justificadoEnPlazoConDeficiencias) && money(d.liquidacion.justificadoFueraDePlazo) && money(d.liquidacion.justificadoFueraDePlazoConDeficiencias) && money(d.liquidacion.noJustificado) && text(d.liquidacion.observacionesLiquidacion,30000) && list(d.documentos,250) &&
        d.estadoGeneral in ['pendiente','en_revision','con_deficiencias','justificado','no_justificado','conforme'] && text(d.fechaCreacion,40) && text(d.fechaModificacion,40) &&
        (!('faseActual' in d) || d.faseActual in ['solicitud','ejecucion','justificacion']) && (!('tecnicosParticipantes' in d)||list(d.tecnicosParticipantes,100));
    }
    function validUser(d,id) {
      return d.keys().hasOnly(['id','nombre','apellidos','nif','email','rol','departamento','cargo','telefono','biometriaHabilitada','dosFactoresHabilitado','certificadoDispositivo','permisos','activo','fechaAlta','avatarUrl','ultimoAcceso','revisionSync','actualizadoPorUid','actualizadoEnServidor']) &&
        d.id==id && validId(id) && text(d.nombre,150) && d.nombre.size()>0 && text(d.apellidos,200) && text(d.email,254) && d.email.matches('^[^@]+@[^@]+[.][^@]+$') &&
        d.rol in ['administrador','jefe_servicio','tecnico','administrativo','auditor','consulta'] && d.activo is bool && text(d.departamento,300) && text(d.cargo,300) &&
        optionalText(d,'nif',30) && optionalText(d,'telefono',50) && optionalText(d,'fechaAlta',40) && optionalText(d,'avatarUrl',2000) && optionalText(d,'ultimoAcceso',40) &&
        d.biometriaHabilitada is bool && d.dosFactoresHabilitado is bool && (!('permisos' in d)|| (d.permisos is map && d.permisos.size()<=10)) && (!('certificadoDispositivo' in d)||(d.certificadoDispositivo is map && d.certificadoDispositivo.size()<=20));
    }
    function validDirectory(d,id) {
      return d.keys().hasOnly(['id','nombre','apellidos','cargo','departamento','rol','activo','revisionSync','actualizadoPorUid','actualizadoEnServidor']) &&
        d.id==id && validId(id) && text(d.nombre,150) && text(d.apellidos,200) && text(d.cargo,300) && text(d.departamento,300) && d.activo is bool &&
        d.rol in ['administrador','jefe_servicio','tecnico','administrativo','auditor','consulta'];
    }
    function validComment(d,id) {
      return d.keys().hasOnly(['id','actuacionId','actuacionNumero','actuacionTitulo','autorId','autorNombre','autorRol','destinatarioId','destinatarioNombre','destinatarioEmail','mensaje','fechaHora','enviadoPorEmail','leido','revisionSync','actualizadoPorUid','actualizadoEnServidor']) &&
        d.id==id && validId(id) && validId(d.actuacionId) && validId(d.autorId) && validId(d.destinatarioId) && text(d.autorNombre,350) && text(d.destinatarioNombre,350) && text(d.destinatarioEmail,254) &&
        text(d.actuacionNumero,150) && text(d.actuacionTitulo,2000) && text(d.mensaje,20000) && d.mensaje.size()>0 && text(d.fechaHora,40) && d.leido is bool && d.enviadoPorEmail==false &&
        d.autorRol in ['administrador','jefe_servicio','tecnico','administrativo'];
    }
    function validAudit(d,id) {
      return d.keys().hasOnly(['id','fechaHora','usuarioId','usuarioNombre','rol','actuacionId','documentoId','documentoTitulo','accion','detalles','dispositivo','ip','revisionSync','actualizadoPorUid','actualizadoEnServidor']) &&
        d.id==id && validId(id) && d.usuarioId==request.auth.uid && d.usuarioNombre==profile().nombre+' '+profile().get('apellidos','') && text(d.usuarioNombre,350) && d.rol==profile().rol && text(d.fechaHora,40) && text(d.actuacionId,128) && text(d.documentoId,128) && text(d.documentoTitulo,2000) &&
        d.accion in ['acceso_pestana','modificacion_checklist','calificacion_estado','exportacion_pdf'] && optionalText(d,'detalles',20000) && optionalText(d,'dispositivo',1000) && optionalText(d,'ip',100);
    }
    function validNotification(d,id) {
      return d.keys().hasOnly(['id','titulo','mensaje','tipo','fechaHora','leida','actuacionId','revisionSync','actualizadoPorUid','actualizadoEnServidor']) && d.id==id && validId(id) &&
        text(d.titulo,500) && text(d.mensaje,2000) && d.tipo in ['alerta','vencimiento','info','exito'] && text(d.fechaHora,40) && d.leida is bool && optionalText(d,'actuacionId',128);
    }
    function validTrash(d,id) {
      return d.keys().hasOnly(['idCopia','fechaBorrado','fechaExpiracion','diasRetencion','borradoPorUsuario','plan','actuacionesAsociadas','motivo','revisionSync','actualizadoPorUid','actualizadoEnServidor']) && d.idCopia==id && validId(id) &&
        text(d.fechaBorrado,40) && text(d.fechaExpiracion,40) && d.diasRetencion is int && d.diasRetencion>=1 && d.diasRetencion<=3650 && text(d.borradoPorUsuario,350) &&
        d.plan is map && d.plan.size()<=30 && list(d.actuacionesAsociadas,100) && optionalText(d,'motivo',2000);
    }
    function validSettings(d,id) {
      return d.keys().hasOnly(['id','notificacionesLeidas','notificacionesPush','recordatoriosEmailDiarios','alertasVencimientoDias','sincronizacionNubeAutomatica','cifradoExtremoAExtremo','modoOscuro','autenticacionBiometrica','autenticacion2FA','revisionSync','actualizadoPorUid','actualizadoEnServidor']) && d.id==id && validId(id) &&
        (!('notificacionesLeidas' in d) || list(d.notificacionesLeidas,5000)) && d.notificacionesPush is bool && d.recordatoriosEmailDiarios is bool && d.alertasVencimientoDias is int && d.alertasVencimientoDias>=0 && d.alertasVencimientoDias<=365 &&
        d.sincronizacionNubeAutomatica is bool && d.cifradoExtremoAExtremo is bool && d.modoOscuro in ['auto','dark','light'] && d.autenticacionBiometrica is bool && d.autenticacion2FA is bool;
    }
    match /planes/{id} {
      allow read: if active();
      allow create: if admin() && validPlan(request.resource.data,id) && metadata(request.resource.data,true);
      allow update: if manager() && validPlan(request.resource.data,id) && sameCreated(request.resource.data) && metadata(request.resource.data,false);
      allow delete: if admin();
    }
    match /actuaciones/{id} {
      allow read: if active();
      allow create: if editor() && validAct(request.resource.data,id) && metadata(request.resource.data,true);
      allow update: if editor() && validAct(request.resource.data,id) && sameCreated(request.resource.data) && metadata(request.resource.data,false) &&
        (manager() || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['tecnicoAsignadoId','tecnicoAsignadoNombre','tecnicoAsignadoCargo']));
      allow delete: if admin();
    }
    match /usuarios/{id} {
      // Datos personales privados: propietario y administración autorizada de personal.
      allow read: if signed() && (request.auth.uid==id || admin());
      allow create: if admin() && validUser(request.resource.data,id) && metadata(request.resource.data,true);
      allow update: if admin() && validUser(request.resource.data,id) && metadata(request.resource.data,false);
      allow delete: if admin() && request.auth.uid!=id;
    }
    match /directorioPersonal/{id} {
      allow read: if active();
      allow create: if admin() && validDirectory(request.resource.data,id) && metadata(request.resource.data,true);
      allow update: if admin() && validDirectory(request.resource.data,id) && metadata(request.resource.data,false);
      allow delete: if admin();
    }
    match /comentarios/{id} {
      allow read: if active() && (manager() || resource==null || resource.data.autorId==request.auth.uid || resource.data.destinatarioId==request.auth.uid);
      allow create: if editor() && validComment(request.resource.data,id) && request.resource.data.autorId==request.auth.uid && request.resource.data.autorRol==profile().rol && request.resource.data.autorNombre==profile().nombre+' '+profile().get('apellidos','') && metadata(request.resource.data,true);
      allow update: if editor() && validComment(request.resource.data,id) && metadata(request.resource.data,false) &&
        (admin() || (resource.data.destinatarioId==request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['leido','revisionSync','actualizadoPorUid','actualizadoEnServidor'])));
      allow delete: if admin();
    }
    match /auditoria/{id} {
      allow read: if active() && (manager() || profile().rol=='auditor' || resource==null || resource.data.usuarioId==request.auth.uid);
      allow create: if active() && validAudit(request.resource.data,id) && metadata(request.resource.data,true);
      allow update,delete: if false;
    }
    match /registrosAuditoria/{id} {
      allow read: if active() && (manager() || profile().rol=='auditor' || resource.data.usuarioId==request.auth.uid);
      allow write: if false;
    }
    match /notificaciones/{id} {
      allow read: if active();
      allow create: if editor() && validNotification(request.resource.data,id) && metadata(request.resource.data,true);
      // El estado de lectura pertenece a configuracionesUsuario/{uid}; el aviso compartido es inmutable.
      allow update: if false;
      allow delete: if admin();
    }
    match /papeleraPlanes/{id} {
      allow read: if admin();
      allow create: if admin() && validTrash(request.resource.data,id) && metadata(request.resource.data,true);
      allow update: if false;
      allow delete: if admin();
    }
    match /configuracionesUsuario/{id} {
      allow read: if active() && request.auth.uid==id;
      allow create: if active() && request.auth.uid==id && validSettings(request.resource.data,id) && metadata(request.resource.data,true);
      allow update: if active() && request.auth.uid==id && validSettings(request.resource.data,id) && metadata(request.resource.data,false);
      allow delete: if false;
    }
    match /{document=**} { allow read,write: if false; }
  }
}
