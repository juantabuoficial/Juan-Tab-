rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // 1. REGLA POR DEFECTO: DENEGACIÓN ABSOLUTA (ZERO-TRUST CATCH-ALL)
    // =========================================================================
    // Ningún documento es accesible a menos que una regla explícita lo autorice.
    match /{document=**} {
      allow read, write: if false;
    }

    // =========================================================================
    // FUNCIONES GLOBALES DE SEGURIDAD Y VALIDACIÓN DE ROLES
    // =========================================================================

    // Comprobar si la petición proviene de un usuario autenticado en Firebase Auth
    function isSignedIn() {
      return request.auth != null && request.auth.uid != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Validación estricta de identificadores seguros (evita caracteres de inyección)
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Obtener datos del perfil del usuario autenticado en Firestore (/usuarios/{uid})
    function getUserData() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }

    // Comprobar si el usuario existe en Firestore y su estado es activo
    function isUserActive() {
      return isSignedIn() && 
             exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)) && 
             getUserData().activo == true;
    }

    // Obtener el rol del usuario autenticado activo
    function userRole() {
      return getUserData().rol;
    }

    // ROL ADMINISTRADOR EXCLUSIVO
    // Autorizado para operaciones administrativas críticas: alta de planes y borrado de cualquier registro
    function isAdmin() {
      return isUserActive() && userRole() == 'administrador';
    }

    // Rol Jefe de Servicio (supervisión técnica y de planes, sin facultades exclusivas de administración)
    function isJefeServicio() {
      return isUserActive() && userRole() == 'jefe_servicio';
    }

    // Personal técnico o administrativo con capacidad de tramitación de expedientes y actuaciones
    function isTecnicoOAdministrativo() {
      return isUserActive() && (userRole() in ['tecnico', 'administrativo', 'jefe_servicio', 'administrador']);
    }

    // Personal autorizado general (incluye perfiles de consulta y auditoría)
    function isPersonalAutorizado() {
      return isUserActive() && (userRole() in ['consulta', 'auditor', 'administrativo', 'tecnico', 'jefe_servicio', 'administrador']);
    }

    // =========================================================================
    // 2. COLECCIÓN DE PLANES DE SUBVENCIONES (/planes/{planId})
    // =========================================================================
    match /planes/{planId} {
      // LECTURA: Solo usuarios autenticados y activos del personal (incluyendo 'consulta' y 'auditor').
      // No se permite lectura pública sin autenticación previa.
      allow read: if isPersonalAutorizado();

      // ALTA DE PLANES: Exclusivamente para usuarios con rol 'administrador'
      allow create: if isAdmin() && isValidId(planId);

      // MODIFICACIÓN DE PLANES: Exclusivamente Administrador o Jefe de Servicio
      allow update: if (isAdmin() || isJefeServicio()) && isValidId(planId);

      // BORRADO DE PLANES: Exclusivamente para usuarios con rol 'administrador'
      allow delete: if isAdmin() && isValidId(planId);
    }

    // =========================================================================
    // 3. COLECCIÓN DE ACTUACIONES Y EXPEDIENTES (/actuaciones/{actuacionId})
    // =========================================================================
    match /actuaciones/{actuacionId} {
      // LECTURA: Solo usuarios debidamente autenticados y activos.
      // El personal con rol 'consulta' puede consultar todas las actuaciones pero no modificarlas.
      allow read: if isPersonalAutorizado();

      // ALTA DE ACTUACIONES: Personal técnico o administrativo autorizado, Jefe de Servicio o Administrador
      allow create: if isTecnicoOAdministrativo() && isValidId(actuacionId);

      // MODIFICACIÓN DE ACTUACIONES: Técnicos y administrativos encargados de la tramitación
      allow update: if isTecnicoOAdministrativo() && isValidId(actuacionId);

      // BORRADO DE ACTUACIONES: Operación administrativa crítica, EXCLUSIVAMENTE rol 'administrador'
      allow delete: if isAdmin() && isValidId(actuacionId);
    }

    // =========================================================================
    // 4. COLECCIÓN DE USUARIOS (/usuarios/{usuarioId})
    // =========================================================================
    match /usuarios/{usuarioId} {
      // LECTURA: Personal autenticado con perfil activo, o el propio usuario autenticado consultando su perfil
      allow read: if isPersonalAutorizado() || (isSignedIn() && request.auth.uid == usuarioId);

      // ALTA DE USUARIOS: solo personal administrador validado.
      // El alta inicial debe realizarse desde un entorno de administración confiable
      // (consola / Admin SDK). Prohibido que un cliente se otorgue roles.
      allow create: if isAdmin() && isValidId(usuarioId);

      // MODIFICACIÓN:
      // - El usuario puede actualizar únicamente su fecha de 'ultimoAcceso'.
      // - El Administrador puede actualizar roles, estados y datos completos de cualquier usuario.
      allow update: if isAdmin() || (
        isSignedIn() && request.auth.uid == usuarioId &&
        incoming().diff(existing()).affectedKeys().hasOnly(['ultimoAcceso'])
      );

      // BORRADO DE USUARIOS: Operación administrativa crítica, EXCLUSIVAMENTE rol 'administrador'
      allow delete: if isAdmin() && isValidId(usuarioId);
    }

    // =========================================================================
    // 5. REGISTROS DE AUDITORÍA INMUTABLES (/auditoria/{registroId} y /registrosAuditoria/{registroId})
    // =========================================================================
    match /auditoria/{registroId} {
      // LECTURA: Exclusiva para auditores de control, administradores y jefes de servicio
      allow read: if isPersonalAutorizado() && (userRole() in ['auditor', 'administrador', 'jefe_servicio']);

      // ALTA: Cualquier usuario autenticado puede generar un registro de auditoría con su UID verificado
      allow create: if isSignedIn() && isValidId(registroId) &&
                       incoming().usuarioId == request.auth.uid;

      // INMUTABILIDAD ADMINISTRATIVA: Ningún usuario (ni siquiera el Administrador) puede alterar o borrar auditorías
      allow update, delete: if false;
    }

    match /registrosAuditoria/{registroId} {
      allow read: if isPersonalAutorizado() && (userRole() in ['auditor', 'administrador', 'jefe_servicio']);
      allow create: if isSignedIn() && isValidId(registroId) &&
                       incoming().usuarioId == request.auth.uid;
      allow update, delete: if false;
    }

    // =========================================================================
    // 6. COMENTARIOS E INSTRUCCIONES TÉCNICAS (/comentarios/{comentarioId})
    // =========================================================================
    match /comentarios/{comentarioId} {
      // LECTURA: Usuarios técnicos relacionados con el mensaje, o Administrador/Jefe
      allow read: if isPersonalAutorizado() && (
        isAdmin() ||
        isJefeServicio() ||
        resource.data.autorId == request.auth.uid ||
        resource.data.destinatarioId == request.auth.uid
      );

      // CREACIÓN: Personal técnico o administrativo autor
      allow create: if isTecnicoOAdministrativo() && isValidId(comentarioId) &&
                       incoming().autorId == request.auth.uid;

      // ACTUALIZACIÓN: Marcar como leído o editar por Administrador
      allow update: if isTecnicoOAdministrativo() && (
        (resource.data.destinatarioId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['leido'])) ||
        isAdmin()
      );

      // BORRADO: Operación administrativa reservada exclusivamente a rol 'administrador'
      allow delete: if isAdmin();
    }

    // =========================================================================
    // 7. NOTIFICACIONES DEL SISTEMA (/notificaciones/{notificacionId})
    // =========================================================================
    match /notificaciones/{notificacionId} {
      allow read: if isPersonalAutorizado();
      allow create: if isTecnicoOAdministrativo();
      allow update: if isPersonalAutorizado() && incoming().diff(existing()).affectedKeys().hasOnly(['leida']);
      // BORRADO: Operación administrativa reservada exclusivamente a rol 'administrador'
      allow delete: if isAdmin();
    }

    // =========================================================================
    // 8. PAPELERA DE RECICLAJE LEGAL (/papeleraPlanes/{copiaId})
    // =========================================================================
    match /papeleraPlanes/{copiaId} {
      // Custodia y vaciado de papelera: Exclusivo del Administrador
      allow read, create, delete: if isAdmin() && isValidId(copiaId);
      allow update: if false;
    }
  }
}
